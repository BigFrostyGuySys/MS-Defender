DeviceFileEvents
| where ActionType == "FileCreated"
| extend strFolderLower = tolower(FolderPath)
| where strFolderLower contains "appdata"
| extend strFileLower = tolower(FileName)
| where strFileLower contains ".crx"
| project Timestamp,
          DeviceName,
          FileName,
          FolderPath,
          InitiatingProcessFileName,
          InitiatingProcessCommandLine
